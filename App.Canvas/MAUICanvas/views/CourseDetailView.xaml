        --><!-- ListView for displaying all students --><!--
        <ListView ItemsSource="{Binding People}" 
                  SelectedItem="{Binding SelectedStudent}"
                  HeightRequest="200">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}" Detail="{Binding Id}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        --><!-- Button for adding the selected student to the course --><!--
        <Button Text="Add Selected Student to Course" 
                Clicked="EnrollButtonClicked"
                IsEnabled="{Binding SelectedStudent}"/>

        <Button Text="Okay" Clicked="OkClicked"/>
        <Button Text="Cancel" Clicked="CancelClicked"/>-->
        <!-- Add student to course StackLayout -->
      
            <!--<Button Text="Add to Course Roster"
    Command="{Binding AddStudentToCourseCommand}" />-->
        <!--</VerticalStackLayout>-->
     
        <Button 
            Text="Okay"
            Clicked="OkClicked"
            />
        <Button
            Text="Cancel"
            Clicked="CancelClicked"/>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>